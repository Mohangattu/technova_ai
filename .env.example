# Local mode returns exact passages, without model downloads or provider credentials.
RAG_MODE=local
# Server-controlled role: EMPLOYEE, MANAGER, AI_ENGINEER, DEVOPS, SECURITY, ADMIN.
ACCESS_LEVEL=EMPLOYEE
# Optional shared workspace key. Required for deployments reachable by other people.
# Set a strong unique value and enter it in the UI's workspace settings.
TECHNOVA_API_KEY=

# Install requirements-ai.txt before using RAG_MODE=groq.
GROQ_API_KEY=
# Optional OpenAI-compatible Groq endpoint, for a proxy or local test service.
GROQ_BASE_URL=
